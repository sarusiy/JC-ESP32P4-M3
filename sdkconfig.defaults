# The board is fitted with a 16 MB flash device.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP32P4_REV_MIN_100=y

# Make the USB-Serial/JTAG port (used for flashing/monitoring, e.g. COM3) the
# primary console so it receives stdin too; the default UART0 console is
# output-only for us here since nothing is wired to UART0's physical pins.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Enable TinyUSB CDC on the board's second (full-speed) USB-C port, used as
# an independent control channel separate from the debug console above.
CONFIG_TINYUSB_CDC_ENABLED=y

# Hosted radio path (P4 host + onboard C6 coprocessor over SDIO).
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_BT_BLE_ENABLED=y
