	(text "R1/R2 select which channel each MAX98357A plays via its SD pin (Adafruit MAX98357 guide): ~100k to 3.3V = Left, ~210k (220k nearest standard value) to 3.3V = Right."
		(at 20 90 0)
		(effects (font (size 1.27 1.27)))
		(uuid "543621bc-0cf2-4e48-81a2-19b23bd086e7")
	)
	(text "GAIN pin on both U1/U2 left unconnected -- default gain, per board default."
		(at 20 95 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1afa1ebe-471c-4391-93cc-7f7ed17b2d42")
	)
	(text "J3 IN1/IN2 both tied to the same GPIO (RELAY_TRIG) so both channels switch together -- this is 2 independent SPDT relays on one board, not a true single-coil DPDT."
		(at 20 100 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d4457750-7fdf-44bb-b55a-79aead67bc18")
	)
	(text "J3 COM/NC pins (to the physical speakers and factory radio tap) are NOT shown here -- that wiring stays entirely on the car side. See QUADLOCK_MEDIA_TAP.md."
		(at 20 105 0)
		(effects (font (size 1.27 1.27)))
		(uuid "86de53ed-be11-4104-89f2-3da39d94487b")
	)
	(text "Low Level Trigger relay module: RELAY_TRIG HIGH = idle (NC, factory radio, safe default), LOW = active (NO, this system's audio)."
		(at 20 110 0)
		(effects (font (size 1.27 1.27)))
		(uuid "2b5336f9-8151-4208-9618-5b8388f9f440")
	)
