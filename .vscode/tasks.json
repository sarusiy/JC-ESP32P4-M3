{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "idf-build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run-idf.ps1",
        "-Action",
        "build",
        "-ProjectPath",
        "${workspaceFolder}",
        "-Target",
        "esp32p4"
      ],
      "isBackground": false
    },
    {
      "label": "idf-clean",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; if (Test-Path build) { Remove-Item build -Recurse -Force }; if (Test-Path managed_components) { Remove-Item managed_components -Recurse -Force }; if (Test-Path dependencies.lock) { Remove-Item dependencies.lock -Force }; Write-Host 'ESP-IDF generated state cleaned.'"
      ],
      "isBackground": false
    },
    {
      "label": "idf-fullclean",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; if (Test-Path build) { Remove-Item build -Recurse -Force }; if (Test-Path managed_components) { Remove-Item managed_components -Recurse -Force }; if (Test-Path dependencies.lock) { Remove-Item dependencies.lock -Force }; Write-Host 'ESP-IDF workspace was fully cleaned.'"
      ],
      "isBackground": false
    },
    {
      "label": "idf-flash-com3",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run-idf.ps1",
        "-Action",
        "flash",
        "-ProjectPath",
        "${workspaceFolder}",
        "-Target",
        "esp32p4",
        "-Port",
        "COM3"
      ],
      "isBackground": false
    },
    {
      "label": "idf-monitor-com3",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run-idf.ps1",
        "-Action",
        "monitor",
        "-ProjectPath",
        "${workspaceFolder}",
        "-Target",
        "esp32p4",
        "-Port",
        "COM3"
      ],
      "isBackground": true
    },
    {
      "label": "open-espressif-ide",
      "type": "shell",
      "command": "C:\\projects\\Espressif-IDE-4.4.0-win32.win32.x86_64\\artifacts\\win32\\Espressif-IDE\\espressif-ide.exe",
      "args": [],
      "isBackground": true
    },
    {
      "label": "open-espressif-ide-this-project",
      "type": "shell",
      "command": "C:\\projects\\Espressif-IDE-4.4.0-win32.win32.x86_64\\artifacts\\win32\\Espressif-IDE\\espressif-ide.exe",
      "args": [
        "-data",
        "c:\\projects\\JC-ESP32P4-M3"
      ],
      "isBackground": true
    },
    {
      "label": "can-mode-passive",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$ErrorActionPreference='Stop'; $board='${input:boardIp}'; Invoke-RestMethod -Uri \"http://$board/api/can/mode\" -Method Post -ContentType 'text/plain' -Body 'passive' | Write-Host; Write-Host \"Board set to passive/listen-only.\""
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "can-mode-active",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$ErrorActionPreference='Stop'; $board='${input:boardIp}'; Invoke-RestMethod -Uri \"http://$board/api/can/mode\" -Method Post -ContentType 'text/plain' -Body 'active' | Write-Host; Write-Host \"Board set to active mode.\""
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "can-monitor-http",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\can-monitor.ps1",
        "-BoardIp",
        "${input:boardIp}",
        "-Mode",
        "live"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "can-status-summary",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\can-monitor.ps1",
        "-BoardIp",
        "${input:boardIp}",
        "-Mode",
        "summary"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "can-live-monitor",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\can-monitor.ps1",
        "-BoardIp",
        "${input:boardIp}",
        "-Mode",
        "live"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "menu",
      "type": "shell",
      "command": "py",
      "args": [
        "-3.11",
        "-m",
        "serial.tools.miniterm",
        "COM5",
        "115200",
        "--echo"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],
  "inputs": [
    {
      "id": "boardIp",
      "type": "promptString",
      "description": "IP address of the ESP32 board for CAN HTTP monitor tasks",
      "default": "192.168.1.50"
    }
  ]
}