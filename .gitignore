build/
build_*/

# Auto-generated by ESP-IDF from sdkconfig.defaults; do not commit.
sdkconfig
sdkconfig.*
!sdkconfig.defaults

# Unrelated reference/asset dump (contains copyrighted ROMs); exclude from VCS.
MakersCourse_6_2026/

# Fetched by the ESP-IDF Component Manager; large generated trees, not source.
managed_components/
dependencies.lock

# Large binary docs (multi-GB workshop manuals); keep local only, too big for GitHub.
Doc/**/*.zip

# Raw CAN capture data pulled from the phone for offline analysis; local
# working data, not source -- keep it on disk, out of the repo. The
# written-up .md analysis docs ARE tracked though, so findings survive
# and are readable/updatable from any machine, not just wherever the
# raw CSVs happen to be sitting.
captures/**
!captures/**/
!captures/**/*.md
